MONGO_USER=tapnswitch
MONGO_PASSWORD=changeme
REDIS_PASSWORD=changeme
APP_NAME=TapNSwitch

INITIAL_ADMIN_PASSWORD=changeme
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@local.dev

CHECKFRONT_WEBHOOK_SECRET=changeme-checkfront-webhook
# Pull sync (Bmore Axes API token) — primary path for Baltimore
CHECKFRONT_API_URL=https://urbanaxesbaltimore.checkfront.com/api/3.0
CHECKFRONT_API_KEY=
CHECKFRONT_API_SECRET=
# Poll today's bookings every N seconds (0 = disabled; 300 = every 5 min)
CHECKFRONT_SYNC_INTERVAL_SECONDS=300
# booking = one event per Checkfront booking; session = merge names by time slot + item
CHECKFRONT_GROUP_MODE=booking
# Optional comma-separated custom field keys with extra thrower names
CHECKFRONT_PLAYER_FIELD_KEYS=thrower_names,participant_names
# Optional comma-separated booking statuses to import
CHECKFRONT_ACCEPT_STATUSES=PAID,CONF,PEND,HOLD,WAIT
# Venue timezone for "today's bookings" filters (Baltimore default)
VENUE_TIMEZONE=America/New_York
# Optional JSON list of venue lanes (defaults to Blue - Left / Black - Right)
# VENUE_ARENAS=[{"id":"blue-left","label":"Blue - Left"},{"id":"black-right","label":"Black - Right"}]
